# Reading a baked table's row by index compiles to loads and arithmetic, no call and no
# branch (the handle, the block's rows pointer and row size, the row, the member); finding a
# row by key is one call into the table's index. Compiles table_read.cpp at -O2 to assembly
# and inspects read_damage_by_index() and find_by_key().
# Invoked by CTest with CXX, STD, SRC, INC (;-list), DEFS (;-list), FLAGS (;-list), OUT.

function(read_body symbol out_var)
  set(incs "")
  foreach(i IN LISTS INC)
    list(APPEND incs "-I${i}")
  endforeach()
  execute_process(
    COMMAND ${CXX} -std=c++${STD} -O2 -S ${FLAGS} ${incs} ${DEFS} ${SRC} -o ${OUT}
    RESULT_VARIABLE rc ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "compiling ${SRC} failed:\n${err}")
  endif()
  file(STRINGS ${OUT} lines)
  set(body "")
  set(inside FALSE)
  foreach(line IN LISTS lines)
    if(line MATCHES "^_?${symbol}:")
      set(inside TRUE)
    elseif(inside AND (line MATCHES "^[^ \t.#]" OR line MATCHES "\\.cfi_endproc|^\t\\.size"))
      break()
    elseif(inside AND line MATCHES "^[ \t]+[a-z]")
      string(STRIP "${line}" insn)
      if(NOT insn MATCHES "^(endbr64|bti|ret|retq|\\.)")
        list(APPEND body "${insn}")
      endif()
    endif()
  endforeach()
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

function(count_calls body out_var)
  set(n 0)
  foreach(insn IN LISTS body)
    if(insn MATCHES "^(call|bl)[ \t]")
      math(EXPR n "${n} + 1")
    endif()
  endforeach()
  set(${out_var} ${n} PARENT_SCOPE)
endfunction()

# By index: loads and arithmetic only.
read_body("_Z20read_damage_by_indexj" body)
list(LENGTH body n)
string(REPLACE ";" "\n  " shown "${body}")
if(n EQUAL 0)
  message(FATAL_ERROR "read_damage_by_index() not found in the assembly")
endif()
foreach(insn IN LISTS body)
  if(insn MATCHES "^(call|jmp|j[a-z]+|bl|b|b\\.[a-z]+|cbn?z|lock)[ \t]")
    message(FATAL_ERROR "a table read by index branches or calls:\n  ${shown}")
  endif()
endforeach()
if(n GREATER 10)
  message(FATAL_ERROR "a table read by index is ${n} instructions, expected at most 10:\n  ${shown}")
endif()
message(STATUS "by index: ${shown}")

# By key: one call, into the index.
read_body("_Z11find_by_keyN5baker6SymbolE" body)
list(LENGTH body n)
string(REPLACE ";" "\n  " shown "${body}")
if(n EQUAL 0)
  message(FATAL_ERROR "find_by_key() not found in the assembly")
endif()
count_calls("${body}" calls)
if(calls GREATER 1)
  message(FATAL_ERROR "a table read by key makes ${calls} calls, expected one:\n  ${shown}")
endif()
message(STATUS "by key: ${shown}")
